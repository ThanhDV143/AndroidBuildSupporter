/* One grid for every row: a 176px label column, then the value column. Spacing on a 4px scale. */

.abs-root {
    flex-grow: 1;
    background-color: var(--unity-colors-window-background);
}

/* Only the scrolling content gives way when the window is short; shrinking the bars squeezed their padding. */
.abs-header,
.abs-tabs,
.abs-legend,
.abs-footer {
    flex-shrink: 0;
}

/* --- Header ---------------------------------------------------------------------------------------------- */

.abs-header {
    flex-direction: row;
    align-items: center;
    padding: 12px 16px;
}

.abs-app-icon {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: 8px;
    margin-right: 12px;
}

.abs-app-icon-empty {
    background-color: rgba(76, 140, 230, 0.35);
}

.abs-app-initial {
    flex-grow: 1;
    -unity-text-align: middle-center;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin: 0;
    padding: 0;
}

.abs-titles {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.abs-title {
    font-size: 15px;
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.abs-subtitle {
    font-size: 11px;
    opacity: 0.7;
}

.abs-badge {
    flex-shrink: 0;
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 10px;
    background-color: rgba(88, 166, 92, 0.18);
    color: rgb(96, 180, 100);
}

.abs-badge-warning {
    background-color: rgba(214, 152, 50, 0.18);
    color: rgb(222, 160, 60);
}

/* --- Tabs: a segmented control --------------------------------------------------------------------------- */

.abs-tabs {
    flex-direction: row;
    margin: 0 16px;
    padding: 3px;
    border-radius: 7px;
    background-color: rgba(0, 0, 0, 0.18);
}

.abs-tab {
    flex-grow: 1;
    flex-basis: 0;
    height: 24px;
    margin: 0;
    padding: 0;
    border-radius: 5px;
    align-items: center;
    justify-content: center;
}

.abs-tab:hover {
    background-color: rgba(128, 128, 128, 0.14);
}

.abs-tab-text {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
    opacity: 0.75;
}

.abs-tab-selected,
.abs-tab-selected:hover {
    background-color: var(--unity-colors-button-background);
}

.abs-tab-selected > .abs-tab-text {
    -unity-font-style: bold;
    opacity: 1;
}

.abs-legend {
    flex-direction: row;
    justify-content: flex-end;
    margin: 6px 16px 0 16px;
}

.abs-legend-item {
    flex-direction: row;
    align-items: center;
    margin-left: 12px;
    font-size: 10px;
    opacity: 0.7;
}

/* --- Pages and cards ------------------------------------------------------------------------------------- */

.abs-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.abs-page {
    padding: 8px 16px 16px 16px;
}

.abs-card {
    margin-bottom: 12px;
    padding: 10px 12px 8px 12px;
    border-width: 1px;
    border-radius: 6px;
    border-color: rgba(128, 128, 128, 0.22);
    background-color: rgba(128, 128, 128, 0.06);
}

.abs-card-title {
    font-size: 12px;
    -unity-font-style: bold;
    margin: 0 0 8px 0;
    padding: 0;
}

.abs-card-description {
    white-space: normal;
    font-size: 11px;
    opacity: 0.7;
    margin: -4px 0 8px 0;
    padding: 0;
}

/* --- Rows ------------------------------------------------------------------------------------------------ */

.abs-row {
    flex-direction: row;
    align-items: flex-start;
    min-height: 20px;
    margin-bottom: 6px;
}

.abs-label {
    flex-direction: row;
    align-items: center;
    width: 176px;
    min-width: 176px;
    height: 20px;
    flex-shrink: 0;
    padding-right: 8px;
}

#abs-label-text {
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 0;
    padding: 0;
}

.abs-dot {
    width: 6px;
    height: 6px;
    flex-shrink: 0;
    border-radius: 3px;
    margin-right: 8px;
}

.abs-dot-unity {
    background-color: rgb(76, 140, 230);
}

.abs-dot-tool {
    background-color: rgb(150, 150, 150);
}

.abs-dot-local {
    background-color: rgb(222, 160, 60);
}

.abs-value {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: row;
    align-items: center;
    min-height: 20px;
}

.abs-control {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 40px;
    margin: 0;
}

.abs-code {
    flex-grow: 0;
    width: 72px;
    min-width: 72px;
    margin-left: 4px;
}

.abs-info {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    -unity-font-style: bold;
    overflow: hidden;
    text-overflow: ellipsis;
}

.abs-info-ok {
    color: rgb(96, 180, 100);
}

.abs-button {
    flex-shrink: 0;
    min-width: 64px;
    height: 20px;
    margin: 0 0 0 4px;
    padding: 0 10px;
}

.abs-button-first {
    margin-left: 0;
}

.abs-check {
    margin: 0 12px 0 0;
    flex-shrink: 0;
}

.abs-check .unity-toggle__text {
    margin-left: 4px;
}

.abs-checks {
    flex-wrap: wrap;
}

.abs-check-cell {
    width: 50%;
    margin: 0 0 2px 0;
}

/* --- Lists of strings ------------------------------------------------------------------------------------ */

.abs-list {
    flex-direction: column;
    align-items: stretch;
}

.abs-inline {
    flex-direction: row;
    align-items: center;
}

.abs-chips {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 2px;
}

.abs-chip {
    flex-direction: row;
    align-items: center;
    height: 20px;
    padding: 0 2px 0 8px;
    margin: 0 4px 4px 0;
    border-width: 1px;
    border-radius: 10px;
    border-color: rgba(128, 128, 128, 0.35);
    background-color: rgba(128, 128, 128, 0.12);
}

.abs-chip > Label {
    font-size: 11px;
    margin: 0;
    padding: 0;
}

.abs-chip-highlight {
    border-color: rgba(222, 160, 60, 0.7);
    background-color: rgba(222, 160, 60, 0.16);
}

.abs-chip-remove {
    width: 16px;
    height: 16px;
    margin: 0 0 0 4px;
    padding: 0;
    border-width: 0;
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0);
    opacity: 0.6;
}

.abs-chip-remove:hover {
    opacity: 1;
    background-color: rgba(128, 128, 128, 0.25);
}

.abs-inline-error {
    font-size: 11px;
    white-space: normal;
    color: rgb(230, 100, 90);
    margin: 4px 0 0 0;
}

/* --- Hints and notices ----------------------------------------------------------------------------------- */

.abs-hint {
    white-space: normal;
    font-size: 11px;
    opacity: 0.65;
    margin: -2px 0 6px 176px;
    padding: 0;
}

.abs-notice {
    white-space: normal;
    font-size: 11px;
    margin: 0 0 8px 0;
    padding: 6px 8px 6px 10px;
    border-left-width: 3px;
    border-radius: 0;
}

.abs-notice-info {
    border-color: rgb(76, 140, 230);
    background-color: rgba(76, 140, 230, 0.10);
}

.abs-notice-ok {
    border-color: rgb(88, 166, 92);
    background-color: rgba(88, 166, 92, 0.12);
}

.abs-notice-warning {
    border-color: rgb(222, 160, 60);
    background-color: rgba(222, 160, 60, 0.12);
}

.abs-notice-error {
    border-color: rgb(220, 80, 70);
    background-color: rgba(220, 80, 70, 0.12);
}

/* --- Footer ---------------------------------------------------------------------------------------------- */

.abs-footer {
    padding: 10px 16px 12px 16px;
    border-top-width: 1px;
    border-color: rgba(128, 128, 128, 0.25);
    background-color: rgba(128, 128, 128, 0.05);
}

.abs-progress {
    height: 4px;
    border-radius: 2px;
    margin-bottom: 6px;
    background-color: rgba(128, 128, 128, 0.25);
    overflow: hidden;
}

.abs-progress-fill {
    height: 100%;
    width: 0;
    border-radius: 2px;
    background-color: rgb(76, 140, 230);
}

.abs-status {
    white-space: normal;
    font-size: 11px;
    margin: 0 0 8px 0;
    padding: 0;
}

.abs-switches {
    flex-direction: row;
    margin-bottom: 8px;
}

.abs-switch {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0;
}

.abs-switch .unity-toggle__text {
    margin-left: 4px;
}

.abs-footer > .abs-notice {
    margin-bottom: 8px;
}

.abs-actions {
    flex-direction: row;
}

.abs-action {
    flex-grow: 1;
    flex-basis: 0;
    height: 30px;
    margin: 0;
    font-size: 12px;
    -unity-font-style: bold;
}

.abs-action-primary {
    margin-left: 8px;
    background-color: rgb(52, 120, 200);
    border-color: rgb(40, 100, 175);
    color: rgb(255, 255, 255);
}

.abs-action-primary:hover {
    background-color: rgb(64, 134, 216);
}

.abs-last {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
}

.abs-state {
    flex-shrink: 0;
    font-size: 10px;
    -unity-font-style: bold;
    padding: 1px 6px;
    margin: 0 8px 0 0;
    border-radius: 8px;
}

.abs-state-ok {
    background-color: rgba(88, 166, 92, 0.2);
    color: rgb(96, 180, 100);
}

.abs-state-warning {
    background-color: rgba(222, 160, 60, 0.2);
    color: rgb(222, 160, 60);
}

.abs-state-error {
    background-color: rgba(220, 80, 70, 0.2);
    color: rgb(230, 100, 90);
}

.abs-last-text {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 11px;
    opacity: 0.75;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 0;
    padding: 0;
}
